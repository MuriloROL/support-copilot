OPENROUTER_API_KEY=
# Any OpenRouter model that supports JSON output.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Worker (npm run worker)
# CHANNEL=mercadolivre uses the real API; leave empty for the simulated marketplace.
CHANNEL=
ML_ACCESS_TOKEN=
ML_SELLER_ID=
SYNC_INTERVAL_MINUTES=5
# Slack-compatible incoming webhook that receives human handoffs; logs to stdout when empty.
HANDOFF_WEBHOOK_URL=
